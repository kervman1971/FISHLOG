  <script>
    // Full Application State & Logic
    let catchesData = JSON.parse(localStorage.getItem('cm_catches') || '[]');
    let spotsData = JSON.parse(localStorage.getItem('cm_spots') || '[]');
    let myNameState = localStorage.getItem('cm_my_name') || '';

    let lastSolunarLat = 42.47;
    let lastSolunarLng = -82.65;
    let spotMapVisible = false;

    function getMyName(){ return myNameState; }
    function ensureMyName(){
      if(!myNameState){
        const n = prompt("Enter your angler name for quick logging:");
        if(n && n.trim()){
          myNameState = n.trim();
          localStorage.setItem('cm_my_name', myNameState);
        }
      }
    }

    function showTab(tabId, btnElem){
      document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active'));
      const target = document.getElementById('tab-' + tabId);
      if(target) target.classList.add('active');

      document.querySelectorAll('.bnav-item').forEach(b => b.classList.remove('active'));
      if(btnElem){
        btnElem.classList.add('active');
      } else {
        document.querySelectorAll(`.bnav-item[data-tab="${tabId}"]`).forEach(b => b.classList.add('active'));
      }
      window.scrollTo(0, 0);
    }

    function showTabByAnchor(tabId){
      const btn = document.querySelector(`.bnav-item[data-tab="${tabId}"]`);
      showTab(tabId, btn);
    }

    function openCatchModal(editId = null){
      ensureMyName();
      document.getElementById('catch-form').reset();
      document.getElementById('catch-edit-id').value = '';
      document.getElementById('catch-modal-title').innerText = 'Log a Catch';

      const d = document.getElementById('catch-datetime');
      const now = new Date();
      const pad = n => String(n).padStart(2,'0');
      d.value = now.getFullYear() + '-' + pad(now.getMonth()+1) + '-' + pad(now.getDate()) + 'T' + pad(now.getHours()) + ':' + pad(now.getMinutes());

      if(myNameState && !editId) {
        document.getElementById('catch-angler').value = myNameState;
      }

      populateSpotSelect();

      if(editId){
        const item = catchesData.find(c => c.id === editId);
        if(item){
          document.getElementById('catch-modal-title').innerText = 'Edit Catch';
          document.getElementById('catch-edit-id').value = item.id;
          document.getElementById('catch-angler').value = item.angler || '';
          document.getElementById('catch-species').value = item.species || '';
          document.getElementById('catch-length').value = item.length || '';
          document.getElementById('catch-weight').value = item.weight || '';
          document.getElementById('catch-spot-select').value = item.spotId || '';
          document.getElementById('catch-lure').value = item.lure || '';
          document.getElementById('catch-notes').value = item.notes || '';
          if(item.datetime) document.getElementById('catch-datetime').value = item.datetime;
        }
      }
      document.getElementById('catch-modal').classList.add('open');
    }

    function openSpotModal(editId = null){
      document.getElementById('spot-form').reset();
      document.getElementById('spot-edit-id').value = '';
      document.getElementById('spot-modal-title').innerText = 'New Hot Spot';

      if(editId){
        const item = spotsData.find(s => s.id === editId);
        if(item){
          document.getElementById('spot-modal-title').innerText = 'Edit Spot';
          document.getElementById('spot-edit-id').value = item.id;
          document.getElementById('spot-name').value = item.name || '';
          document.getElementById('spot-lat').value = item.lat || '';
          document.getElementById('spot-lng').value = item.lng || '';
          document.getElementById('spot-notes').value = item.notes || '';
        }
      }
      document.getElementById('spot-modal').classList.add('open');
    }

    function closeModals(){
      document.querySelectorAll('.modal-overlay').forEach(m => m.classList.remove('open'));
    }

    function populateSpotSelect(){
      const sel = document.getElementById('catch-spot-select');
      sel.innerHTML = '<option value="">-- Select Spot --</option>';
      spotsData.forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.name;
        sel.appendChild(opt);
      });
    }

    function saveCatch(e){
      e.preventDefault();
      const editId = document.getElementById('catch-edit-id').value;
      const fileInput = document.getElementById('catch-photo-file');

      const processRecord = (photoUrl) => {
        const record = {
          id: editId ? editId : 'c_' + Date.now(),
          angler: document.getElementById('catch-angler').value.trim(),
          species: document.getElementById('catch-species').value.trim(),
          length: parseFloat(document.getElementById('catch-length').value) || 0,
          weight: parseFloat(document.getElementById('catch-weight').value) || 0,
          spotId: document.getElementById('catch-spot-select').value,
          lure: document.getElementById('catch-lure').value.trim(),
          datetime: document.getElementById('catch-datetime').value,
          notes: document.getElementById('catch-notes').value.trim(),
          photo: photoUrl || (editId ? (catchesData.find(c => c.id === editId)?.photo || '') : '')
        };

        if(editId){
          const idx = catchesData.findIndex(c => c.id === editId);
          if(idx >= 0) catchesData[idx] = record;
        } else {
          catchesData.unshift(record);
        }

        localStorage.setItem('cm_catches', JSON.stringify(catchesData));
        closeModals();
        renderAll();
      };

      if(fileInput.files && fileInput.files[0]){
        const reader = new FileReader();
        reader.onload = function(evt){
          processRecord(evt.target.result);
        };
        reader.readAsDataURL(fileInput.files[0]);
      } else {
        processRecord(null);
      }
    }

    function saveSpot(e){
      e.preventDefault();
      const editId = document.getElementById('spot-edit-id').value;
      const record = {
        id: editId ? editId : 's_' + Date.now(),
        name: document.getElementById('spot-name').value.trim(),
        lat: parseFloat(document.getElementById('spot-lat').value) || 0,
        lng: parseFloat(document.getElementById('spot-lng').value) || 0,
        notes: document.getElementById('spot-notes').value.trim()
      };

      if(editId){
        const idx = spotsData.findIndex(s => s.id === editId);
        if(idx >= 0) spotsData[idx] = record;
      } else {
        spotsData.push(record);
      }

      localStorage.setItem('cm_spots', JSON.stringify(spotsData));
      closeModals();
      renderAll();
    }

    function deleteCatch(id){
      if(confirm('Are you sure you want to delete this catch?')){
        catchesData = catchesData.filter(c => c.id !== id);
        localStorage.setItem('cm_catches', JSON.stringify(catchesData));
        renderAll();
      }
    }

    function deleteSpot(id){
      if(confirm('Delete this spot?')){
        spotsData = spotsData.filter(s => s.id !== id);
        localStorage.setItem('cm_spots', JSON.stringify(spotsData));
        renderAll();
      }
    }
