    }

    .weather-strip{
      background:rgba(0,0,0,.22);
      border:1px solid var(--panel-border);
      border-radius:var(--radius-sm);
      padding:14px;
      margin-bottom:14px;
    }
    .weather-strip-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:8px;
      font-size:12px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.5px;
      color:var(--muted);
    }
    .weather-grid{
      display:grid;
      grid-template-columns:repeat(4, minmax(0,1fr));
      gap:8px;
      text-align:center;
    }
    .weather-cell{
      background:rgba(255,255,255,.06);
      border-radius:10px;
      padding:8px 4px;
    }
    .weather-cell .val{
      font-family:"Baloo 2",sans-serif;
      font-size:16px;
      font-weight:800;
      color:#fff;
      line-height:1.2;
    }
    .weather-cell .lbl{
      font-size:9.5px;
      color:var(--muted);
      font-weight:700;
      text-transform:uppercase;
      margin-top:2px;
    }

    .solunar-card{
      background:linear-gradient(165deg, rgba(0,40,60,.85), rgba(0,20,30,.92));
      border:1px solid var(--panel-border-2);
      border-radius:var(--radius-sm);
      padding:14px 16px;
      margin-bottom:14px;
    }
    .solunar-header{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:10px;
    }
    .solunar-title{
      font-family:"Baloo 2",sans-serif;
      font-size:18px;
      font-weight:800;
      color:#fff;
      margin:0;
    }
    .solunar-badge{
      background:var(--gold);
      color:#000;
      font-size:11px;
      font-weight:800;
      padding:4px 10px;
      border-radius:999px;
      text-transform:uppercase;
      letter-spacing:.4px;
    }
    .rating-row{
      display:flex;
      align-items:center;
      justify-content:space-between;
      background:rgba(255,230,0,.08);
      border:1px solid rgba(255,230,0,.25);
      border-radius:12px;
      padding:10px 14px;
      margin-bottom:10px;
    }
    .rating-stars{
      color:var(--gold);
      font-size:18px;
      letter-spacing:2px;
    }
    .rating-label{
      font-family:"Baloo 2",sans-serif;
      font-size:12px;
      font-weight:800;
      letter-spacing:1px;
      color:var(--gold-2);
