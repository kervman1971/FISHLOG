    }
    .rating-moon{
      width:44px;height:44px;
      display:grid;
      place-items:center;
      font-size:26px;
    }
    .solunar-facts{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:6px;
      margin-bottom:8px;
    }
    .fact{
      display:flex;
      align-items:center;
      justify-content:space-between;
      background:rgba(255,255,255,.05);
      border-radius:8px;
      padding:6px 10px;
    }
    .fact-label{
      font-size:10px;
      color:var(--muted);
      font-weight:700;
    }
    .fact-val{
      font-size:11.5px;
      color:#fff;
      font-weight:800;
      font-family:"Baloo 2",sans-serif;
      text-align:right;
    }
    .solunar-section-label{
      font-family:"Baloo 2",sans-serif;
      font-size:12px;
      font-weight:800;
      color:#fff;
      margin:10px 0 6px;
      padding-top:8px;
      border-top:1px solid var(--line);
      display:flex;
      align-items:center;
      gap:5px;
    }
    .solunar-section-label.major-label::before{content:"🟠";font-size:9px;}
    .solunar-section-label.minor-label::before{content:"🔵";font-size:9px;}

    .planner-form{
      background:var(--panel);
      border:1px solid var(--panel-border);
      border-radius:var(--radius-sm);
      backdrop-filter:blur(8px);
      -webkit-backdrop-filter:blur(8px);
      padding:16px;
      margin-bottom:14px;
      display:grid;
      gap:12px;
    }
    .planner-search-row{
      display:grid;
      grid-template-columns:1fr auto;
      gap:8px;
      align-items:center;
    }
    .planner-location-list{
      margin-top:8px;
      display:grid;
      gap:6px;
    }
    .planner-location-btn{
      background:rgba(255,255,255,.08);
      border:1px solid var(--panel-border);
      border-radius:8px;
      padding:8px 12px;
      text-align:left;
      color:#fff;
      font-size:12.5px;
      font-weight:600;
      cursor:pointer;
    }
    .planner-location-btn:hover{background:rgba(255,255,255,.15)}

    .forecast-day-card{
      background:rgba(255,255,255,.96);
      border-radius:var(--radius-sm);
      color:#101D33;
      margin-bottom:12px;
      overflow:hidden;
      box-shadow:0 8px 24px rgba(0,0,0,.25);
    }
    .fdc-head{
      background:linear-gradient(160deg, #005F73, #0096B4);
      color:#fff;
      padding:12px 16px;
      display:flex;
      justify-content:space-between;
      align-items:center;
    }
    .fdc-date{
      font-family:"Baloo 2",sans-serif;
      font-size:16px;
      font-weight:800;
    }
    .fdc-sub{
      font-size:11px;
      color:rgba(255,255,255,.85);
      font-weight:700;
      margin-top:2px;
    }
    .fdc-rating{
      text-align:right;
    }
    .fdc-rating .stars{
      font-size:15px;
      letter-spacing:1px;
    }
    .fdc-rating .lbl{
      font-size:10px;
      font-weight:800;
      letter-spacing:.4px;
      margin-top:2px;
    }
    .fdc-body{
      padding:12px 16px;
    }
    .fdc-row{
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:8px 0;
      border-bottom:1px solid #F1F4F6;
      font-size:12.5px;
    }
    .fdc-row:last-child{border-bottom:none}
    .fdc-row .k{
      color:#5A6B7D;
      font-weight:700;
      display:flex;
      align-items:center;
      gap:6px;
    }
    .fdc-row .v{
      font-weight:800;
      color:#101D33;
    }
    .fdc-row .v.major{color:#C44700}
    .fdc-row .v.minor{color:#2B7FD9}

    .activity-chart{
      background:rgba(255,255,255,.05);
      border-radius:10px;
      padding:7px 10px 6px;
      margin-bottom:7px;
    }
    .ap-peak{
      text-align:center;
      font-family:"Baloo 2",sans-serif;
      font-size:12px;
      font-weight:800;
      color:#fff;
      margin-bottom:3px;
    }
    .ap-bars{
      display:flex;
      align-items:flex-end;
      gap:2px;
      height:26px;
    }
    .ap-bar{
      flex:1;
      background:linear-gradient(180deg, var(--gold), var(--orange-2));
      border-radius:2px 2px 0 0;
      min-height:8%;
    }
    .ap-range{
      display:flex;
      justify-content:space-between;
      font-size:9.5px;
      color:var(--muted);
      margin-top:3px;
      font-weight:700;
    }

    .intel-grid{
      display:grid;
      gap:14px;
    }
    .intel-card{
      overflow:hidden;
    }
    .intel-head{
      background:linear-gradient(160deg, #005F73, #0096B4);
      color:#fff;
      padding:14px 16px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
    }
    .intel-title{
      font-family:"Baloo 2",sans-serif;
      font-size:18px;
      font-weight:800;
      margin:0;
    }
    .intel-subtitle{
      font-size:11.5px;
      color:rgba(255,255,255,.85);
      margin-top:2px;
      font-weight:700;
    }
    .intel-body{
      padding:14px 16px;
    }
    .intel-desc{
      font-size:13px;
      color:#3A4A5E;
      line-height:1.55;
      margin-bottom:12px;
    }
    .intel-timeline{
      display:grid;
      grid-template-columns:repeat(5, minmax(0,1fr));
      gap:6px;
      text-align:center;
      background:#F8FBFB;
      border:1px solid #E2EEF0;
      border-radius:12px;
      padding:10px 8px;
    }
    .intel-time-col{
      display:flex;
      flex-direction:column;
      align-items:center;
    }
    .intel-time-lbl{
      font-size:9.5px;
      font-weight:800;
      color:#5A6B7D;
      text-transform:uppercase;
      letter-spacing:.3px;
      margin-bottom:6px;
    }
    .intel-time-icon{
      font-size:16px;
      margin-bottom:6px;
    }
    .intel-bar-wrap{
      width:32px;
      height:64px;
      background:#F0F8FA;
      border-radius:6px;
      overflow:hidden;
      display:flex;
      align-items:flex-end;
      margin-bottom:5px;
    }
    .intel-bar{
      width:100%;
      border-radius:6px 6px 0 0;
      transition:height .4s ease;
    }
    .intel-bar.high{background:#0096B4}
    .intel-bar.mid{background:#FFE600}
    .intel-bar.low{background:#E0E0E0}
    .intel-pct{
      font-family:"Baloo 2",sans-serif;
      font-size:13px;
      font-weight:800;
      color:#003344;
    }
    .intel-lures{
      padding:10px 14px 12px;
    }
    .intel-lures-label{
      font-size:9.5px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.4px;
      color:#5A6B7D;
      margin-bottom:7px;
    }
    .intel-lure-list{
      display:flex;
      flex-wrap:wrap;
      gap:6px;
    }
    .intel-lure{
      font-size:11px;
      font-weight:700;
      padding:4px 10px;
      border-radius:999px;
      background:#E0F7FA;
      color:#003344;
    }

    .footer-space{height:160px}
    .hint{font-size:12px;color:var(--muted);margin-top:6px}
    .quick-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
    .chip{
      border:1px solid var(--panel-border-2);
      background:rgba(255,255,255,.07);
      color:#fff;
      border-radius:999px;
      padding:8px 12px;
      font-size:12px;
      font-weight:700;
    }
  </style>
</head>
<body>

  <div class="app">
    <header class="topbar">
      <div class="topbar-inner">
        <div class="brand">
          <div class="brand-mark">🎣</div>
          <div class="brand-text">
            <h1 class="brand-name">C'mon Bell!</h1>
            <p class="brand-sub" id="top-sub">Field Log & Analytics</p>
          </div>
        </div>
        <div class="top-actions">
          <button class="btn btn-secondary btn-sm btn-icon" onclick="openSpotModal()">📍 New Spot</button>
          <button class="btn btn-primary btn-sm btn-icon" onclick="openCatchModal()">🎣 Log Catch</button>
        </div>
      </div>
    </header>

    <main>
      <section class="section active" id="tab-dashboard">
        <div class="hero">
          <div class="hero-inner">
            <div class="hero-kicker">⚡ Live Fishing Hub</div>
            <h2 class="hero-title" id="hero-welcome">Tight Lines & Good Times</h2>
            <p class="hero-copy" id="hero-status">Track group catches, analyze hot patterns, and pinpoint your next winning spot instantly.</p>
            <div class="hero-actions">
              <button class="btn btn-primary" onclick="openCatchModal()">🎣 Log New Catch</button>
              <button class="btn btn-secondary" onclick="showTabByAnchor('catches')">📖 View All Catches</button>
            </div>
          </div>
        </div>

        <div class="glance-grid" style="margin-bottom:14px;">
          <div class="stat">
            <div class="stat-label">Total Catches</div>
            <div class="stat-value green" id="stat-total-catches">0</div>
          </div>
          <div class="stat">
            <div class="stat-label">Total Species</div>
            <div class="stat-value blue" id="stat-total-species">0</div>
          </div>
        </div>

        <div class="weather-strip" id="weather-strip-box">
          <div class="weather-strip-head">
            <span id="weather-location-label">Local Conditions</span>
            <span id="weather-time-label">Live</span>
          </div>
          <div class="weather-grid">
            <div class="weather-cell">
              <div class="val" id="wx-temp">--°</div>
              <div class="lbl">Temp</div>
            </div>
            <div class="weather-cell">
              <div class="val" id="wx-wind">--</div>
              <div class="lbl">Wind</div>
            </div>
            <div class="weather-cell">
              <div class="val" id="wx-baro">--</div>
              <div class="lbl">Barometer</div>
            </div>
            <div class="weather-cell">
              <div class="val" id="wx-cond">--</div>
              <div class="lbl">Condition</div>
            </div>
          </div>
        </div>

        <div class="solunar-card" id="dashboard-solunar">
          <div class="solunar-header">
            <h3 class="solunar-title">Solunar Feed Insights</h3>
            <span class="solunar-badge" id="sol-phase-badge">Calculating...</span>
          </div>
          <div class="rating-row">
            <div>
              <div class="rating-stars" id="sol-stars">★★★★☆</div>
              <div class="rating-label" id="sol-rating-text">PEAK ACTIVITY WINDOW</div>
            </div>
            <div class="rating-moon" id="sol-moon-emoji">🌕</div>
          </div>
          <div class="solunar-facts">
            <div class="fact">
              <span class="fact-label">Sunrise / Sunset</span>
              <span class="fact-val" id="sol-sun">--:-- / --:--</span>
            </div>
            <div class="fact">
              <span class="fact-label">Moonrise / Set</span>
              <span class="fact-val" id="sol-moon">--:-- / --:--</span>
            </div>
          </div>
          <div class="solunar-section-label major-label">Major Solunar Windows</div>
          <div class="solunar-facts">
            <div class="fact">
              <span class="fact-label">Morning Window</span>
              <span class="fact-val" id="sol-maj1">--:-- - --:--</span>
            </div>
            <div class="fact">
              <span class="fact-label">Evening Window</span>
              <span class="fact-val" id="sol-maj2">--:-- - --:--</span>
            </div>
          </div>
          <div class="solunar-section-label minor-label">Minor Solunar Windows</div>
          <div class="solunar-facts">
            <div class="fact">
              <span class="fact-label">Window 1</span>
              <span class="fact-val" id="sol-min1">--:-- - --:--</span>
            </div>
            <div class="fact">
              <span class="fact-label">Window 2</span>
              <span class="fact-val" id="sol-min2">--:-- - --:--</span>
            </div>
          </div>
        </div>

        <div class="strip">
          <div class="strip-card">
            <div class="strip-header">
              <h3 class="strip-title">Recent Activity</h3>
              <button class="small-link" onclick="showTabByAnchor('catches')">View All →</button>
            </div>
            <div id="dashboard-mini-catches"></div>
          </div>
        </div>
      </section>

      <section class="section" id="tab-catches">
        <div class="page-head">
          <div>
            <h2>Catch Log</h2>
            <p>Search your field notes and review the story behind every fish.</p>
          </div>
        </div>
        <div class="strip-card" style="margin-bottom:12px;">
          <div class="search-row">
            <input class="field" type="text" id="search-input" placeholder="Search species, spot, angler, lure, notes..." oninput="renderCatches()" />
            <div class="search-filters">
              <select class="select" id="filter-angler" onchange="renderCatches()">
                <option value="">All anglers</option>
              </select>
              <select class="select" id="filter-species" onchange="renderCatches()">
                <option value="">All species</option>
              </select>
            </div>
          </div>
          <div class="hint">Tip: use quick chips on the dashboard to instantly filter common catches.</div>
        </div>
        <div id="catch-list" class="section-grid"></div>
      </section>

      <section class="section" id="tab-trips">
        <div class="page-head">
          <div>
            <h2>Trips</h2>
            <p>Every outing, automatically grouped by day across the whole group.</p>
          </div>
        </div>
        <div id="trip-list"></div>
      </section>

      <section class="section" id="tab-forecast">
        <div class="page-head">
          <div>
            <h2>Solunar & Weather Planner</h2>
            <p>Plan future trips with location-based lunar ratings and bite windows.</p>
          </div>
        </div>

        <div class="planner-form">
          <div class="field-group">
            <label class="field-label">Target Location / Water Body</label>
            <div class="planner-search-row">
              <input class="field" type="text" id="planner-location" placeholder="e.g. Lake St. Clair, Islamorada, Tampa Bay..." />
              <button class="btn btn-primary" onclick="plannerSearch()">Search</button>
            </div>
            <div class="planner-location-list" id="planner-location-results"></div>
          </div>
          <div class="row-2">
            <div class="field-group">
              <label class="field-label">Date</label>
              <input class="field" type="date" id="planner-date" onchange="runPlannerForecast()" />
            </div>
            <div class="field-group">
              <label class="field-label">Quick Presets</label>
              <select class="select" id="planner-preset" onchange="applyPlannerPreset()">
                <option value="">Select favorite water...</option>
                <option value="42.47,-82.65">Lake St. Clair</option>
                <option value="24.93,-80.62">Islamorada, FL Keys</option>
                <option value="27.95,-82.45">Tampa Bay, FL</option>
                <option value="36.55,-88.13">Kentucky Lake</option>
              </select>
            </div>
          </div>
        </div>

        <div id="forecast-results-container"></div>
      </section>

      <section class="section" id="tab-spots">
        <div class="page-head">
          <div>
            <h2>Hot Spots</h2>
            <p>Saved waypoints, coordinates, and productive zones.</p>
          </div>
          <button class="btn btn-primary btn-sm" onclick="openSpotModal()">📍 New Spot</button>
        </div>
        <div id="spot-list" class="section-grid"></div>
      </section>

      <section class="section" id="tab-stats">
        <div class="page-head">
          <div>
